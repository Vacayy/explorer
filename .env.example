# Explorer 환경변수 예시 — 복사해서 `.env`로 쓴다 (`.env`는 gitignore).
# 없어도 뜨는 것과 없으면 기능이 죽는 것을 구분해 적었다.

# ── 필수 ────────────────────────────────────────────────────────────
# DART 공시·재무 (무료 발급: https://opendart.fss.or.kr)
DART_API_KEY=

# LLM 엔진. claude-code = Claude Code CLI를 구독 인증으로 호출(API 키 불필요).
#   api      = ANTHROPIC_API_KEY 사용
#   keyword  = LLM 없이 키워드 매칭으로 폴백(태깅 품질 낮음, 개발용)
ENRICH_ENGINE=claude-code
# `which claude` 결과의 절대경로. launchd에서 PATH가 좁아 절대경로가 필요하다.
CLAUDE_BIN=/usr/local/bin/claude

# ── 선택 ────────────────────────────────────────────────────────────
# ENRICH_ENGINE=api 로 쓸 때만
ANTHROPIC_API_KEY=

# 매크로·유동성 카드의 순유동성(WALCL−TGA−RRP)·M2. 없으면 유동성만 degraded로 표시된다.
# 무료 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 미국 실적 컨콜 전문. 무료 티어 25건/일 — 없으면 컨콜 기능만 비활성.
ALPHAVANTAGE_API_KEY=
TRANSCRIPT_PROVIDER=alphavantage

# 관세청 수출입 통계 (공공데이터포털)
DATA_GO_KR_KEY=

# 텔레그램 아침 브리핑·양방향 봇. 셋 다 있어야 발송된다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING=1

# 저장 경로 (기본: 프로젝트 내 vault/ · media/)
VAULT_PATH=
MEDIA_PATH=

# ── 모델 티어 오버라이드 (기본값은 코드에 있음) ──────────────────────
# 용도별 기본 티어는 docs/TECH_DECISIONS.md "비용에서 나온 결정 › 티어는 용도로 고정" 참조.
# RAG_MODEL=sonnet
# NARRATIVE_MODEL=opus
# ENRICH 등 기계적 호출은 haiku 고정.
